{
  "name": "Nexent Fusion Style",
  "dataColors": [
    "#F21D2F",
    "#1F6B52",
    "#4A3D8F",
    "#5C3D2E",
    "#F25D27",
    "#F2811D",
    "#F2BC8D",
    "#F23E2E"
  ],
  "background": "#FFFDFC",
  "foreground": "#160D0A",
  "tableAccent": "#F21D2F",
  "good": "#00581D",
  "bad": "#F21D2F",
  "neutral": "#7A7370",
  "maximum": "#F21D2F",
  "center": "#F25D27",
  "minimum": "#F2BC8D",
  "hyperlink": "#F25D27",
  "visitedHyperlink": "#F2BC8D",
  "textClasses": {
    "largeTitle": {
      "fontFace": "Georgia",
      "fontSize": 28,
      "color": "#160D0A"
    },
    "title": {
      "fontFace": "Georgia",
      "fontSize": 18,
      "color": "#160D0A"
    },
    "header": {
      "fontFace": "Arial",
      "fontSize": 11,
      "color": "#4A403C"
    },
    "label": {
      "fontFace": "Arial",
      "fontSize": 10,
      "color": "#160D0A"
    },
    "callout": {
      "fontFace": "Arial",
      "fontSize": 24,
      "color": "#F25D27"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false,
            "color": { "solid": { "color": "#FFFDFC" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false,
            "color": { "solid": { "color": "#E5D8D3" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FAF3F1" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#FAF3F1" } },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false,
            "radius": 0
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#7A7370" } },
            "fontFamily": "Arial",
            "textSize": 8,
            "bold": true,
            "outline": "None"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#160D0A" } },
            "background": { "solid": { "color": "#FFFDFC" } },
            "fontFamily": "Arial",
            "textSize": 10,
            "outline": "None"
          }
        ]
      }
    }
  }
}
