function coinsForRange(idxs, lo, hi, product){

  let coll=0, red=0;

  idxs.forEach(i=>{

    const mult = productMultiplier(i, product);

    const tierShare=TIER_SHARE[TIERS.length-1-i];

    for(let m=lo;m<=hi;m++){

      coll += COLLECTED_M[m]*tierShare*mult;

      red  += REDEEMED_M[m]*tierShare*mult;

    }

  });

  return {coll, red};

}
 
