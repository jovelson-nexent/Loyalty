/* ================= Formatting helpers ================= */

function fmtNum(v){

  const sign = v<0 ? '-' : ''; const a = Math.abs(v);

  const trim = n => { const r = Math.round(n*10)/10; return Number.isInteger(r) ? r.toString() : r.toFixed(1); };

  if(a>=1e9) return sign+trim(a/1e9)+'B';

  if(a>=1e6) return sign+trim(a/1e6)+'M';

  if(a>=1e3) return sign+trim(a/1e3)+'K';

  return sign+trim(a);

}

function fmtPct(v){ return Math.round(v)+'%'; }

function fmtK(v){ return Math.round(v)+'K'; }
 
