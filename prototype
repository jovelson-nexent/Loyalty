/* ================= Filter state helpers (shared by every tab) ================= */

function filterState(){

  const s = MONTHS.indexOf(startSel.value), e = MONTHS.indexOf(endSel.value);

  const lo = Math.min(s,e), hi = Math.max(s,e);

  return {

    lo, hi,

    endFrac: 0.05 + 0.95 * ((hi+1)/MONTHS.length),

    rangeFrac: (hi-lo+1)/MONTHS.length,

    product: productFilterSel.value,

    tier: tierFilterSel.value

  };

}

function productMultiplier(tierIdx, product){

  if(product==='wizz') return WIZZ_SHARE[tierIdx];

  if(product==='cardavantaj') return 1-WIZZ_SHARE[tierIdx];

  return 1;

}

function tierIndices(tierFilter){

  if(tierFilter==='all') return TIERS.map((t,i)=>i);

  const idx = TIERS.indexOf(tierFilter);

  return idx>=0 ? [idx] : TIERS.map((t,i)=>i);

}

// Same as tierIndices but returns indices into the ASCENDING (Starter-first) arrays.

function tierIndicesAsc(tierFilter){

  if(tierFilter==='all') return TIERS_ASC.map((t,i)=>i);

  const idx = TIERS_ASC.indexOf(tierFilter);

  return idx>=0 ? [idx] : TIERS_ASC.map((t,i)=>i);

}

function pick(arr, idxs){ return idxs.map(i=>arr[i]); }
 
function periodLabel(){

  const activeBtn = document.querySelector('.preset-btn.active');

  if(activeBtn) return activeBtn.dataset.preset.toUpperCase();

  return startSel.value===endSel.value ? startSel.value : `${startSel.value} → ${endSel.value}`;

}
 
