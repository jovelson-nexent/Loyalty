    {label:'Period B',data:[],backgroundColor:RED,datalabels:dl(v=>v.raw??v,{anchor:'end',align:'end'})}

  ]},options:{scales:{x:catAxis(),y:valueAxis()},plugins:{legend:{position:'bottom'},datalabels:{display:true,color:INK,font:{weight:600,size:10},anchor:'end',align:'end'}}}});

  pcKpiSel.addEventListener('change', ()=>refreshAll());

