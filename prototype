const FIN_INACTIVE_PROFIT_RATIO=0.28, FIN_INACTIVE_TRX_RATIO=0.35;
 
function refreshFinancialTab(fs){

  const idxs = tierIndices(fs.tier);

  const prodMult = fs.product==='wizz' ? 1.08 : fs.product==='cardavantaj' ? 0.995 : 1.0;
 
  // ---- Overall Active vs Inactive ----

  const activeMembers = idxs.reduce((s,i)=>s+ACTIVE[i],0);

  const inactiveMembers = idxs.reduce((s,i)=>s+(MEMBERS[i]-ACTIVE[i]),0);

  const activeProfit = 132*prodMult, inactiveProfit = 38*prodMult;

  const activeTrx = 5.8, inactiveTrx = 2.1;

  const rows=[

    ['Active', activeMembers.toLocaleString(), activeProfit.toFixed(1), activeTrx.toFixed(1)],

    ['Inactive', inactiveMembers.toLocaleString(), inactiveProfit.toFixed(1), inactiveTrx.toFixed(1)],

  ];

  const profitDelta = ((activeProfit-inactiveProfit)/inactiveProfit*100).toFixed(0);

  const trxDelta = ((activeTrx-inactiveTrx)/inactiveTrx*100).toFixed(0);

  document.getElementById('activeVsInactiveOverallBody').innerHTML = rows.map(r=>`<tr><td>${r[0]}</td><td class="num">${r[1]}</td><td class="num">${r[2]}</td><td class="num">${r[3]}</td></tr>`).join('')

    + `<tr class="total-row"><td>Δ% (Active vs Inactive)</td><td class="num">—</td><td class="num" style="color:var(--green);">+${profitDelta}%</td><td class="num" style="color:var(--green);">+${trxDelta}%</td></tr>`;
 
  // ---- Per-tier Active vs Inactive ----

  const tfRows = idxs.map(i=>{

    const [label, activeProfitT, activeTrxT] = FIN_TFBASE[i];

    const activeM = ACTIVE[i], inactiveM = MEMBERS[i]-ACTIVE[i];

    const ap = activeProfitT*prodMult, at = activeTrxT;

    if(inactiveM===0){

      return `<tr><td>${label}</td><td class="num">${activeM.toLocaleString()}</td><td class="num">0</td>
<td class="num groupsep">${ap.toFixed(1)}</td><td class="num">—</td><td class="num">—</td>
<td class="num groupsep">${at.toFixed(1)}</td><td class="num">—</td><td class="num">—</td></tr>`;

    }

    const ip = ap*FIN_INACTIVE_PROFIT_RATIO, it = at*FIN_INACTIVE_TRX_RATIO;

    const pd = ((ap-ip)/ip*100).toFixed(0), td = ((at-it)/it*100).toFixed(0);

    return `<tr><td>${label}</td><td class="num">${activeM.toLocaleString()}</td><td class="num">${inactiveM.toLocaleString()}</td>
<td class="num groupsep">${ap.toFixed(1)}</td><td class="num">${ip.toFixed(1)}</td><td class="num" style="color:var(--green);">+${pd}%</td>
<td class="num groupsep">${at.toFixed(1)}</td><td class="num">${it.toFixed(1)}</td><td class="num" style="color:var(--green);">+${td}%</td></tr>`;

  });

  document.getElementById('tierFinancialsTableBody').innerHTML = tfRows.join('');

}
 
