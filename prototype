  document.getElementById('chKpiEnrollRate').textContent = fmtPct(100*totalEnrolled/totalMembers);

  document.getElementById('chKpiCompleteRate').textContent = fmtPct(100*totalCompleted/totalEnrolled);

  // Defensible per-person figures: weighted avg of the tier-level avg columns

  const wAvgEnroll = rowsAsc.reduce((s,r)=>s+r.avgEnroll*r.members,0)/totalMembers;

  const wAvgComplete = rowsAsc.reduce((s,r)=>s+r.avgComplete*r.members,0)/totalMembers;

