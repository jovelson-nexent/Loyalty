function periodAvg(kpi, tierIdx, startVal, endVal, product){

  const s=MONTHS.indexOf(startVal), e=MONTHS.indexOf(endVal);

  const lo=Math.min(s,e), hi=Math.max(s,e);

  const slice = TREND_SERIES[kpi][tierIdx].slice(lo,hi+1);

  const avg = slice.reduce((a,b)=>a+b,0)/slice.length;

  return Math.round(avg*productMultiplier(tierIdx,product)*100)/100;

}

function periodLabelShort(startVal,endVal){ return startVal===endVal ? startVal : `${startVal} → ${endVal}`; }
 
function refreshPeriodComparisonTab(fs){

  const idxs = tierIndices(fs.tier);

  const kpi = pcKpiSel.value;

  const fmt = TREND_FORMATTERS[kpi];

  const labelA = periodLabelShort(pcAStart.value,pcAEnd.value);

  const labelB = periodLabelShort(pcBStart.value,pcBEnd.value);
 
  const dataA = idxs.map(i=>periodAvg(kpi,i,pcAStart.value,pcAEnd.value,fs.product));

  const dataB = idxs.map(i=>periodAvg(kpi,i,pcBStart.value,pcBEnd.value,fs.product));
 
  chPeriodCompare.data.labels = pick(TIERS, idxs);

  chPeriodCompare.data.datasets[0].label = `Period A (${labelA})`;

  chPeriodCompare.data.datasets[0].data = dataA;

  chPeriodCompare.data.datasets[1].label = `Period B (${labelB})`;

  chPeriodCompare.data.datasets[1].data = dataB;

  chPeriodCompare.data.datasets[0].datalabels.formatter = v=>fmt(v);

  chPeriodCompare.data.datasets[1].datalabels.formatter = v=>fmt(v);

  chPeriodCompare.update();
 
  document.getElementById('pcColA').textContent = `Period A (${labelA})`;

  document.getElementById('pcColB').textContent = `Period B (${labelB})`;

  document.getElementById('pcTableBody').innerHTML = idxs.map((i,k)=>{

    const av=dataA[k], bv=dataB[k];

    const deltaAbs = Math.round((bv-av)*100)/100;

    const deltaPct = av!==0 ? (deltaAbs/av*100) : null;

    const color = deltaAbs>=0 ? 'var(--green)' : 'var(--red)';

    return `<tr><td>${TIERS[i]}</td><td class="num">${fmt(av)}</td><td class="num">${fmt(bv)}</td><td class="num" style="color:${color};">${deltaAbs>=0?'+':''}${fmt(deltaAbs)}</td><td class="num" style="color:${color};">${deltaPct!==null?(deltaPct>=0?'+':'')+deltaPct.toFixed(1)+'%':'—'}</td></tr>`;

  }).join('');

}
 
